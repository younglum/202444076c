#include <stdio.h>
int main(){
    int a=10;

    printf("Hello, World!\n");
    printf("%d\n", a); //부호있는 10진수
    printf("%u\n", a); //부호없는 10진수
    printf("%o\n", a); //부호없는 8진수
    printf("%x, %X\n", a,a); //부호없는 16진수. x는 소문자 a~f, X는 대문자 A~F
    printf("%hd\n", a); //부호있는 짧은 정수
    printf("%ld\n", a); //긴 정수(long)
    printf("%lld\n", a); //메우 긴 정수(long long)

    float b=1.12;

    printf("%f\n", b); //기본 소수점 출력
    printf("%e\n", b); //지수 표기
    printf("%g\n", b); //값의 크기에 따라 %f 또는 %e중 더 짧은것으로 자동 출력

    char *c="h";
    printf("%c\n", *c); //기본 문자 출력  
    printf("%c\n", *c); //문자열 출력(char* 포인터)

    printf("%p\n", a); //해당 값의 메모리 주소값
    printf("%%\n"); // "%"를 출력
    return 0;
};

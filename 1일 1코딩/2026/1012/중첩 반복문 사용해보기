#include <stdio.h>
int main() {
    int a=0, b=0, c=0;
    for(a=0; a<5; a++){
        for(b=0; b<3; b++){
            printf("현재 연산 반복 횟수 : %d\n", b);
            printf("현재 c의 값 : %d\n", c);
            c++;
        }
        c=0;
        printf("현재 루프 반복 횟수 : %d\n", a);
        printf("--------연산루프 끝 -------\n");
    }
}
